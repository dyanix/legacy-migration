# .env.example — copy to .env and fill in your own values.
#   cp .env.example .env
# Never commit the real .env file (it's already in .gitignore).
# This file IS committed, so it must contain placeholders only — never a
# real key. Anything pasted here is published.

# ── Source database ──
# Matches the credentials in docker-compose.yml. Port 3307 avoids clashing
# with a local MySQL on the default 3306.
SOURCE_DB_URL=mysql+pymysql://legacy_user:legacy_pass@localhost:3307/legacy_db

# ── LLM — REQUIRED ──
# agents/ai_mapper.py raises without this, so a fresh clone cannot run the
# pipeline from scratch until it is set. agents/doc_generator.py uses the
# same variables and degrades to rule-derived descriptions if absent.
# ANTHROPIC_API_KEY is accepted as a fallback name by both.
LLM_API_KEY=sk-ant-your-key-here
# Set explicitly: ai_mapper and doc_generator each carry their own fallback
# default, so leaving this unset can silently run the two nodes on
# different models.
LLM_MODEL=claude-sonnet-5

# ── Confidence gate ──
# Mappings at or above this score are auto-approved; anything below routes
# to the Flask review UI for a human decision. See DECISIONS.md §1 for the
# reasoning behind this value.
CONFIDENCE_THRESHOLD=0.80

# ── Migration target ──
# "snowflake" (production target).
TARGET_BACKEND=snowflake


# ── LangFuse observability ──
# Tracing for every LLM call. Optional: workflow/tracing.py degrades to a
# no-op when these are unset, so the pipeline runs identically without them.
# Get keys from https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to false to disable tracing without removing the keys.
# LANGFUSE_ENABLED=true

# ── dbt validation layer ──
# Schema the generated dbt sources point at. Must match SNOWFLAKE_SCHEMA
# ("PUBLIC"); SQLite uses "main".
# This MUST live here rather than being passed on the command line: the
# orchestrator regenerates the dbt models on every run, and without it they
# default to "main" and dbt fails with
#   Schema 'MIGRATION_TARGET.MAIN' does not exist or not authorized.
DBT_TARGET_SCHEMA=PUBLIC

# ── Snowflake target (required when TARGET_BACKEND=snowflake) ──
# ACCOUNT is the ORG-ACCOUNT identifier, NOT the full
# https://...snowflakecomputing.com URL -- passing the URL is the most common
# connection failure. Get it with:
#   SELECT CURRENT_ORGANIZATION_NAME(), CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
# Confirm with SELECT CURRENT_USER(); the UI display name is not always the
# login name.
SNOWFLAKE_USER=your_username
# Quote this if it contains a '#', or dotenv truncates at that character.
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MIGRATION_TARGET
SNOWFLAKE_SCHEMA=PUBLIC

# ── Optional overrides ──
# Migrate a subset of tables instead of all of them.
# MIGRATE_TABLES=dept_master,prv_tbl
# Skip doc_generator's LLM call entirely.
# DOC_GENERATOR_USE_LLM=true
# Use a different model for the data dictionary only.
# DOC_GENERATOR_MODEL=